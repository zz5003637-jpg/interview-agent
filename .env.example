# Copy to .env and fill in on the API proxy server only (Vercel Environment Variables).
# Never commit .env with real secrets.
# Never expose LLM_API_KEY in the GitHub Pages frontend.

# DeepSeek example (recommended):
# LLM_API_KEY=sk-xxxxxxxx
# LLM_API_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

LLM_API_KEY=
LLM_API_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# CORS: comma-separated allowed browser origins
# Example: https://yourname.github.io,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional shortcut for your GitHub Pages production origin
GITHUB_PAGES_ORIGIN=https://yourname.github.io
